---
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from "../config";
import { ViewTransitions } from "astro:transitions";
import { FALLBACK_TECH_META, TECH_META } from "../data/techMeta";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  sideBarActiveItemID?: string;
  includeSidebar?: boolean;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, image, ogType = "website", sideBarActiveItemID } = Astro.props;
const isHome = sideBarActiveItemID === "home";
const loaderTechs = ["Python", "STM32", "Django", "Vue", "Spring Boot", "Android"];
---

<!doctype html>
<html lang="zh-CN" data-theme="lofi" class:list={{ "archive-loading-active": isHome }}>
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} />
    {isHome && (
      <>
        <link rel="modulepreload" href="/holo-avatar-web/app.bundle.js?v=20260921-3" />
        <link rel="preload" as="image" href="/holo-avatar-web/assets/background.png" fetchpriority="high" />
        <link rel="preload" as="image" href="/holo-avatar-web/assets/subject.png" fetchpriority="high" />
      </>
    )}
    {TRANSITION_API && <ViewTransitions />}
  </head>
  <body class:list={[isHome ? "home-page" : "inner-page", { "archive-loading-active": isHome }]}>
    <div class="scene galactic-scene" id="scene" aria-hidden="true" style="--sky-top:#020208;--sky-mid:#030513;--sky-bottom:#05081c;--stars-opacity:.8">
      <canvas class="galactic-background" id="galacticBackground"></canvas>
      <div class="cursor-aura" id="cursorAura"></div>
      <canvas class="ambient-particles" id="ambientParticles"></canvas>
      <div class="stars" id="stars"></div>
    </div>
    <div class="scrim" id="scrim" aria-hidden="true"></div>

    {isHome && (
      <div id="loader" class="archive-loader archive-loading" aria-label="正在加载项目档案" aria-live="polite">
        <div class="loader-inner">
          <div class="loader-sigil" aria-hidden="true"><i></i><i></i><span>Y</span></div>
          <div class="loader-title">INITIALIZING PROJECT ARCHIVE</div>
          <div class="folder-container" id="folderContainer">
            {loaderTechs.map((tech) => {
              const meta = TECH_META[tech] ?? FALLBACK_TECH_META;
              return <div class="folder" data-folder={tech} style={`--brand:${meta.color}`}><div class="folder-icon" aria-hidden="true" set:html={meta.svg}></div><div class="folder-name">{tech}</div></div>;
            })}
          </div>
          <div class="loading-status" id="loadingStatus">preparing /system</div>
          <div class="progress-wrapper"><div id="progress"></div></div>
          <div class="progress-bottom"><span>LOADING TECH STACK</span><span id="progressText">0%</span></div>
        </div>
        <canvas class="welcome-particle-canvas" id="welcomeParticles" aria-hidden="true"></canvas>
        <div class="welcome" id="welcome" aria-hidden="true"></div>
      </div>
    )}

    <div id="siteShell" class="site-shell">
      <a class="skip-link" href="#home">跳到主要内容</a>
      <nav class="archive-nav" aria-label="主导航">
        <a class="nav-logo" href="/" aria-label="燚燿项目档案首页">Y燚</a>
        <div class="nav-links"><a href="/">HOME</a><a href="/projects/">PROJECTS</a><a href="/#about">ABOUT</a></div>
        <a class="nav-github" href="https://github.com/yishuo299" target="_blank" rel="noreferrer">GITHUB ↗</a>
      </nav>
      <main class:list={["archive-main", isHome ? "archive-home" : "archive-content"]}><slot /></main>
      <footer class="archive-footer"><div class="container"><span>BUILD. LEARN. REPEAT.</span><span>© {new Date().getFullYear()} 燚燿 · PROJECT ARCHIVE</span></div></footer>
    </div>

    <div id="bookLoader" class="book-loader" aria-hidden="true">
      <div class="book-loader-inner">
        <div class="book" aria-hidden="true">
          <span class="book-cover"></span><span class="book-page page-one"></span><span class="book-page page-two"></span><span class="book-page page-three"></span>
        </div>
        <div class="book-loader-text">OPENING ARTICLE</div>
      </div>
    </div>
    <div class="copy-status" id="copyStatus" role="status" aria-live="polite"></div>

    <script>
      import { navigate } from "astro:transitions/client";
      import { createGalacticBackground } from "../scripts/galacticBackground";

      let archiveCleanup: () => void = () => {};

      const initArchive = () => {
        archiveCleanup();
        document.body.classList.remove("modal-open", "cosmic-transitioning", "motion-warmup", "heavy-warmup");
        const controller = new AbortController();
        const timers: number[] = [];
        const intervals: number[] = [];
        let motionFrame = 0;
        let welcomeFrame = 0;
        let globalArticleTimer = 0;
        let cancelled = false;
        const lockPage = () => {
          document.documentElement.classList.add("archive-loading-active");
          document.body.classList.add("archive-loading-active");
          window.scrollTo(0, 0);
        };
        const unlockPage = () => {
          document.documentElement.classList.remove("archive-loading-active");
          document.body.classList.remove("archive-loading-active");
        };
        const later = (callback: () => void, delay: number) => { const timer = window.setTimeout(callback, delay); timers.push(timer); return timer; };
        const wait = (delay: number) => new Promise<void>((resolve) => later(resolve, delay));
        const pad = (value: number) => String(value).padStart(2, "0");
        const scene = document.getElementById("scene") as HTMLElement | null;
        const scrim = document.getElementById("scrim") as HTMLElement | null;
        const stars = document.getElementById("stars") as HTMLElement | null;
        const ambientCanvas = document.getElementById("ambientParticles") as HTMLCanvasElement | null;
        const galacticCanvas = document.getElementById("galacticBackground") as HTMLCanvasElement | null;
        const cursorAura = document.getElementById("cursorAura") as HTMLElement | null;
        const bigTime = document.getElementById("bigTime");
        const bigDate = document.getElementById("bigDate");
        const bigPeriod = document.getElementById("bigPeriod");
        const bgPanel = document.getElementById("bgPanel");
        const bgSlider = document.getElementById("bgSlider") as HTMLInputElement | null;
        const bgPanelTime = document.getElementById("bgPanelTime");
        const bgPanelPeriod = document.getElementById("bgPanelPeriod");
        const bgLive = document.getElementById("bgLive");
        const bgClose = document.getElementById("bgClose");
        const clockAdjust = document.getElementById("clockAdjust");
        const copyStatus = document.getElementById("copyStatus");
        if (!scene || !scrim || !stars || !ambientCanvas || !galacticCanvas) return;

        const galacticBackground = createGalacticBackground(galacticCanvas);

        stars.replaceChildren();
        const compactScreen = window.matchMedia("(max-width: 600px)").matches;
        const navigatorWithMemory = navigator as Navigator & { deviceMemory?: number };
        const lowPowerDevice = (navigator.hardwareConcurrency > 0 && navigator.hardwareConcurrency <= 4) || (navigatorWithMemory.deviceMemory ?? 8) <= 4;
          const starCount = 0;
        const starFragment = document.createDocumentFragment();
        for (let index = 0; index < starCount; index += 1) {
          const star = document.createElement("i");
            star.className = "star"; star.style.left = `${Math.random() * 100}%`; star.style.top = `${Math.random() * 96}%`;
          const size = Math.random() > 0.82 ? 3 : 2; star.style.width = `${size}px`; star.style.height = `${size}px`; starFragment.appendChild(star);
        }
        stars.appendChild(starFragment);

        type AmbientPoint = { x: number; y: number; vx: number; vy: number; radius: number; alpha: number; phase: number; depth: number };
        type BurstPoint = { x: number; y: number; vx: number; vy: number; radius: number; life: number; maxLife: number; color: string };
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
        const particleContext = ambientCanvas.getContext("2d", { alpha: true });
        const ambientPoints: AmbientPoint[] = [];
        const burstPoints: BurstPoint[] = [];
        const holoAvatar = document.querySelector<HTMLElement>("[data-holo-avatar]");
        const holoCard = holoAvatar?.querySelector<HTMLElement>(".holo-avatar-card") ?? null;
        let viewportWidth = window.innerWidth;
        let viewportHeight = window.innerHeight;
        let pointerX = viewportWidth * 0.5;
        let pointerY = viewportHeight * 0.45;
        let auraX = pointerX;
        let auraY = pointerY;
        let pointerAwake = false;
        let targetRotateX = -2.5;
        let targetRotateY = 4;
        let rotateX = targetRotateX;
        let rotateY = targetRotateY;
        let avatarDragging = false;
        let avatarLastX = 0;
        let avatarLastY = 0;
        let lastFrameAt = performance.now();
        let randomState = 0x2f6e2b1;
        const seededRandom = () => {
          randomState = (randomState * 1664525 + 1013904223) >>> 0;
          return randomState / 4294967296;
        };
        const resetAmbientPoints = () => {
          ambientPoints.length = 0;
          randomState = 0x2f6e2b1;
          const count = compactScreen ? 36 : lowPowerDevice ? 54 : 78;
          for (let index = 0; index < count; index += 1) {
            const depth = 0.35 + seededRandom() * 0.9;
            ambientPoints.push({
              x: seededRandom() * viewportWidth,
              y: seededRandom() * viewportHeight,
              vx: (seededRandom() - 0.5) * 2.2 * depth,
              vy: -(0.35 + seededRandom() * 2.1) * depth,
              radius: 0.45 + seededRandom() * 1.35,
              alpha: 0.12 + seededRandom() * 0.3,
              phase: seededRandom() * Math.PI * 2,
              depth,
            });
          }
        };
        const resizeMotionSurface = () => {
          viewportWidth = window.innerWidth;
          viewportHeight = window.innerHeight;
          const pixelRatio = Math.min(window.devicePixelRatio || 1, compactScreen || lowPowerDevice ? 1.15 : 1.5);
          ambientCanvas.width = Math.max(1, Math.round(viewportWidth * pixelRatio));
          ambientCanvas.height = Math.max(1, Math.round(viewportHeight * pixelRatio));
          ambientCanvas.style.width = `${viewportWidth}px`;
          ambientCanvas.style.height = `${viewportHeight}px`;
          particleContext?.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
          resetAmbientPoints();
        };
        const emitBurst = (x: number, y: number, color = "#9bdcff") => {
          if (reduceMotion) return;
          const amount = compactScreen ? 9 : lowPowerDevice ? 11 : 16;
          for (let index = 0; index < amount; index += 1) {
            const angle = (Math.PI * 2 * index) / amount + seededRandom() * 0.3;
            const speed = 34 + seededRandom() * 86;
            const maxLife = 0.52 + seededRandom() * 0.42;
            burstPoints.push({ x, y, vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed - 18, radius: 1 + seededRandom() * 2.3, life: maxLife, maxLife, color });
          }
          if (burstPoints.length > 90) burstPoints.splice(0, burstPoints.length - 90);
        };
        const drawMotionSurface = (now: number, dt: number, animate: boolean) => {
          if (document.body.classList.contains("archive-loading-active") || document.body.classList.contains("cosmic-transitioning") || document.body.classList.contains("modal-open")) return;
          if (cursorAura) {
            const auraFollow = reduceMotion ? 1 : 1 - Math.exp(-5.5 * dt);
            auraX += (pointerX - auraX) * auraFollow;
            auraY += (pointerY - auraY) * auraFollow;
            cursorAura.style.transform = `translate3d(${auraX.toFixed(1)}px,${auraY.toFixed(1)}px,0) translate(-50%,-50%)`;
          }
          if (particleContext) {
            particleContext.clearRect(0, 0, viewportWidth, viewportHeight);
            const isDay = document.body.classList.contains("day");
            particleContext.globalCompositeOperation = isDay ? "source-over" : "screen";
            ambientPoints.forEach((point, pointIndex) => {
              if (animate) {
                const sway = Math.sin(now * 0.00018 + point.phase) * 0.58;
                const centerX = viewportWidth * 0.52;
                const centerY = viewportHeight * 0.46;
                const orbitX = point.x - centerX;
                const orbitY = point.y - centerY;
                const orbitDistance = Math.max(80, Math.hypot(orbitX, orbitY));
                const orbitForce = 1.8 * point.depth;
                point.x += (point.vx + sway - (orbitY / orbitDistance) * orbitForce) * dt;
                point.y += (point.vy + (orbitX / orbitDistance) * orbitForce) * dt;
                if (pointerAwake) {
                  const dx = point.x - pointerX;
                  const dy = point.y - pointerY;
                  const distanceSquared = dx * dx + dy * dy;
                  if (distanceSquared > 1 && distanceSquared < 15000) {
                    const force = (1 - distanceSquared / 15000) * 20 * dt;
                    const distance = Math.sqrt(distanceSquared);
                    point.x += (dx / distance) * force;
                    point.y += (dy / distance) * force;
                  }
                }
                if (point.y < -12) { point.y = viewportHeight + 12; point.x = seededRandom() * viewportWidth; }
                if (point.x < -12) point.x = viewportWidth + 12;
                if (point.x > viewportWidth + 12) point.x = -12;
              }
              const shimmer = 0.72 + Math.sin(now * 0.0012 + point.phase) * 0.28;
              if (pointIndex % 5 === 0) {
                particleContext.beginPath();
                particleContext.fillStyle = isDay
                  ? `rgba(45, 132, 168, ${point.alpha * 0.08 * shimmer})`
                  : `rgba(126, 210, 241, ${point.alpha * 0.13 * shimmer})`;
                particleContext.arc(point.x, point.y, point.radius * point.depth * 4.8, 0, Math.PI * 2);
                particleContext.fill();
              }
              particleContext.beginPath();
              particleContext.fillStyle = isDay
                ? `rgba(35, 92, 132, ${point.alpha * 0.52 * shimmer})`
                : `rgba(207, 232, 255, ${point.alpha * shimmer})`;
              particleContext.arc(point.x, point.y, point.radius * point.depth, 0, Math.PI * 2);
              particleContext.fill();
            });
            for (let index = burstPoints.length - 1; index >= 0; index -= 1) {
              const point = burstPoints[index];
              if (animate) {
                point.life -= dt;
                point.x += point.vx * dt;
                point.y += point.vy * dt;
                point.vx *= Math.exp(-3.4 * dt);
                point.vy += 42 * dt;
              }
              if (point.life <= 0) { burstPoints.splice(index, 1); continue; }
              const life = point.life / point.maxLife;
              particleContext.beginPath();
              particleContext.fillStyle = point.color;
              particleContext.globalAlpha = Math.max(0, life * 0.72);
              particleContext.arc(point.x, point.y, point.radius * (0.6 + life * 0.5), 0, Math.PI * 2);
              particleContext.fill();
              particleContext.globalAlpha = 1;
            }
            particleContext.globalCompositeOperation = "source-over";
          }

          const applyHoloAvatar = () => {
            if (!holoCard) return;
            holoCard.style.setProperty("--rotate-x", `${rotateX.toFixed(3)}deg`);
            holoCard.style.setProperty("--rotate-y", `${rotateY.toFixed(3)}deg`);
            holoCard.style.setProperty("--depth-x", `${(rotateY * 0.42).toFixed(3)}px`);
            holoCard.style.setProperty("--depth-y", `${(-rotateX * 0.42).toFixed(3)}px`);
          };

          if (holoCard) {
            const idleX = pointerAwake ? 0 : Math.sin(now * 0.00045) * 1.5;
            const idleY = pointerAwake ? 0 : Math.cos(now * 0.00038) * 2.2;
            const follow = avatarDragging ? 1 : 1 - Math.exp(-10 * dt);
            rotateX += (targetRotateX + idleX - rotateX) * follow;
            rotateY += (targetRotateY + idleY - rotateY) * follow;
            applyHoloAvatar();
          }
        };
        const tickMotion = (now: number) => {
          if (cancelled) return;
          const dt = Math.min((now - lastFrameAt) / 1000, 1 / 30);
          lastFrameAt = now;
          drawMotionSurface(now, dt, true);
          motionFrame = window.requestAnimationFrame(tickMotion);
        };
        resizeMotionSurface();
        window.addEventListener("resize", resizeMotionSurface, { signal: controller.signal, passive: true });
        window.addEventListener("pointermove", (event) => { pointerX = event.clientX; pointerY = event.clientY; pointerAwake = true; }, { signal: controller.signal, passive: true });
        window.addEventListener("archive:burst", (event) => {
          const detail = (event as CustomEvent<{ x?: number; y?: number; color?: string }>).detail ?? {};
          emitBurst(detail.x ?? viewportWidth * 0.5, detail.y ?? viewportHeight * 0.5, detail.color);
        }, { signal: controller.signal });
        const syncHoloAvatarImmediately = () => {
          rotateX = targetRotateX;
          rotateY = targetRotateY;
          holoCard?.style.setProperty("--rotate-x", `${rotateX.toFixed(3)}deg`);
          holoCard?.style.setProperty("--rotate-y", `${rotateY.toFixed(3)}deg`);
          holoCard?.style.setProperty("--depth-x", `${(rotateY * 0.42).toFixed(3)}px`);
          holoCard?.style.setProperty("--depth-y", `${(-rotateX * 0.42).toFixed(3)}px`);
        };
        holoAvatar?.addEventListener("pointerdown", (event) => {
          if (event.button !== 0 && event.pointerType === "mouse") return;
          avatarDragging = true;
          pointerAwake = true;
          avatarLastX = event.clientX;
          avatarLastY = event.clientY;
          holoAvatar.classList.add("is-active", "is-dragging");
          holoAvatar.setPointerCapture(event.pointerId);
        }, { signal: controller.signal });
        holoAvatar?.addEventListener("pointermove", (event) => {
          const rect = holoAvatar.getBoundingClientRect();
          const px = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
          const py = Math.max(0, Math.min(1, (event.clientY - rect.top) / rect.height));
          if (avatarDragging) {
            const dx = event.clientX - avatarLastX;
            const dy = event.clientY - avatarLastY;
            targetRotateY += dx * 0.72;
            targetRotateX += dy * 0.72;
            avatarLastX = event.clientX;
            avatarLastY = event.clientY;
            if (reduceMotion) syncHoloAvatarImmediately();
          } else if (finePointer && !reduceMotion) {
            targetRotateX = (0.5 - py) * 15;
            targetRotateY = (px - 0.5) * 18;
          }
          holoCard?.style.setProperty("--light-x", `${(px * 100).toFixed(2)}%`);
          holoCard?.style.setProperty("--light-y", `${(py * 100).toFixed(2)}%`);
          holoCard?.style.setProperty("--foil-shift", `${((px + py) * 50).toFixed(2)}%`);
        }, { signal: controller.signal });
        const stopAvatarDrag = (event: PointerEvent) => {
          avatarDragging = false;
          holoAvatar?.classList.remove("is-dragging");
          try { holoAvatar?.releasePointerCapture(event.pointerId); } catch {}
        };
        holoAvatar?.addEventListener("pointerup", stopAvatarDrag, { signal: controller.signal });
        holoAvatar?.addEventListener("pointercancel", stopAvatarDrag, { signal: controller.signal });
        holoAvatar?.addEventListener("pointerenter", () => { pointerAwake = true; holoAvatar.classList.add("is-active"); }, { signal: controller.signal });
        holoAvatar?.addEventListener("pointerleave", () => {
          if (!avatarDragging) pointerAwake = false;
          holoAvatar.classList.remove("is-active");
        }, { signal: controller.signal });
        document.addEventListener("visibilitychange", () => {
          if (reduceMotion) return;
          window.cancelAnimationFrame(motionFrame);
          if (!document.hidden) { lastFrameAt = performance.now(); motionFrame = window.requestAnimationFrame(tickMotion); }
        }, { signal: controller.signal });
        if (reduceMotion) drawMotionSurface(0, 0, false);
        else motionFrame = window.requestAnimationFrame(tickMotion);

        const hexToRgb = (hex: string) => { const value = hex.replace("#", ""); return { r: Number.parseInt(value.slice(0, 2), 16), g: Number.parseInt(value.slice(2, 4), 16), b: Number.parseInt(value.slice(4, 6), 16) }; };
        const mixColor = (from: string, to: string, amount: number) => {
          const a = hexToRgb(from); const b = hexToRgb(to); const channels = ["r", "g", "b"] as const;
          return `#${channels.map((key) => Math.round(a[key] + (b[key] - a[key]) * amount).toString(16).padStart(2, "0")).join("")}`;
        };
        const smoothStep = (value: number) => value * value * (3 - 2 * value);
        const samplePalette = (hour: number, stops: Array<{ hour: number; colors: string[] }>) => {
          const current = Math.max(0, Math.min(24, hour));
          let endIndex = stops.findIndex((stop) => stop.hour >= current);
          if (endIndex <= 0) endIndex = 1;
          const start = stops[endIndex - 1], end = stops[Math.min(endIndex, stops.length - 1)];
          const amount = smoothStep(Math.max(0, Math.min(1, (current - start.hour) / Math.max(0.001, end.hour - start.hour))));
          return start.colors.map((color, index) => mixColor(color, end.colors[index], amount));
        };
        const skyStops = [
          { hour: 0, colors: ["#000000", "#010208", "#05070d"] }, { hour: 4.5, colors: ["#000000", "#010208", "#05070d"] },
          { hour: 6.7, colors: ["#18121f", "#80687f", "#d7a7b2"] }, { hour: 9.2, colors: ["#f2f7f8", "#c8dde4", "#7ea6b7"] },
          { hour: 15.5, colors: ["#f2f7f8", "#c8dde4", "#7ea6b7"] }, { hour: 18.6, colors: ["#160914", "#773449", "#d97872"] },
          { hour: 21.4, colors: ["#000000", "#010208", "#05070d"] }, { hour: 24, colors: ["#000000", "#010208", "#05070d"] },
        ];
        const nebulaStops = [
          { hour: 0, colors: ["#153785", "#5c247d", "#09152f"] }, { hour: 4.5, colors: ["#153785", "#5c247d", "#09152f"] },
          { hour: 6.7, colors: ["#28a9bd", "#d66386", "#6b304f"] }, { hour: 9.2, colors: ["#25c9e8", "#447ee8", "#55bdd0"] },
          { hour: 15.5, colors: ["#25c9e8", "#447ee8", "#55bdd0"] }, { hour: 18.6, colors: ["#e64f6d", "#8944c8", "#9d3b65"] },
          { hour: 21.4, colors: ["#153785", "#5c247d", "#09152f"] }, { hour: 24, colors: ["#153785", "#5c247d", "#09152f"] },
        ];
        const calculateSky = (minutes: number) => samplePalette(minutes / 60, skyStops);
        const periodLabel = (hour: number) => hour < 5 ? "DEEP NIGHT" : hour < 8 ? "DAWN NEBULA" : hour < 16 ? "BLUE ORBIT" : hour < 20 ? "DUSK NEBULA" : "DEEP NIGHT";
          const getScrim = (_hour: number) => 0;
        const updateScene = (minutes: number) => {
          galacticBackground.setTime(minutes);
          const hour = minutes / 60; const [top, middle, bottom] = calculateSky(minutes);
          const sunProgress = Math.max(0, Math.min(1, (minutes - 300) / 840));
          const moonProgress = Math.max(0, Math.min(1, minutes >= 1200 ? (minutes - 1200) / 240 : minutes / 300));
          const sunOpacity = Math.max(0, Math.min(1, hour < 5 ? 0 : hour < 6 ? hour - 5 : hour > 18.5 ? 1 - (hour - 18.5) / 0.8 : 1));
          const moonOpacity = hour >= 19.5 ? Math.min(1, (hour - 19.5) / 1.5) : hour < 5 ? Math.max(0, 1 - hour / 5) : 0;
          const daylight = Math.max(0, Math.sin(Math.max(0, Math.min(1, (hour - 5) / 14)) * Math.PI));
          const dawnGlow = Math.max(0, 1 - Math.abs(hour - 6.4) / 2.2);
          const duskGlow = Math.max(0, 1 - Math.abs(hour - 18.2) / 2.4);
          const twilight = Math.max(dawnGlow, duskGlow);
          const cosmicPhase = (minutes / 1440) * Math.PI * 2;
          const cosmicDegrees = (minutes / 1440) * 360;
          const timeFlowX = Math.cos(cosmicPhase) * 9;
          const timeFlowY = Math.sin(cosmicPhase) * 6;
          const starFlowX = Math.sin(cosmicPhase) * 5;
          const starFlowY = Math.cos(cosmicPhase) * 3.5;
          const starFlowDuration = Math.round(92 - daylight * 34);
          const starOpacity = Math.max(0.2, 1 - daylight * 0.78 + twilight * 0.12);
          scene.style.setProperty("--sky-top", top); scene.style.setProperty("--sky-mid", middle); scene.style.setProperty("--sky-bottom", bottom);
          scene.style.setProperty("--sun-x", `${8 + sunProgress * 84}%`); scene.style.setProperty("--sun-y", `${75 - Math.sin(sunProgress * Math.PI) * 58}%`); scene.style.setProperty("--sun-opacity", String(sunOpacity));
          scene.style.setProperty("--moon-x", `${78 - moonProgress * 40}%`); scene.style.setProperty("--moon-y", `${27 + Math.sin(moonProgress * Math.PI) * 12}%`); scene.style.setProperty("--moon-opacity", String(moonOpacity));
          scene.style.setProperty("--stars-opacity", String(starOpacity)); scene.style.setProperty("--cloud-opacity", String(hour < 6 || hour > 21 ? 0.32 : 0.18));
          scene.style.setProperty("--deep-star-opacity", String(starOpacity * 0.72));
          scene.style.setProperty("--near-star-opacity", String(starOpacity * 0.34));
          const nebulaSets = samplePalette(hour, nebulaStops);
          const cosmicSaturation = 1.28 + twilight * 0.34 - daylight * 0.08;
          const nebulaStrength = 0.92 - daylight * 0.2 + twilight * 0.18;
          scene.style.setProperty("--nebula-a", nebulaSets[0] as string);
          scene.style.setProperty("--nebula-b", nebulaSets[1] as string);
          scene.style.setProperty("--galaxy-opacity", (0.98 - daylight * 0.36 + twilight * 0.14).toFixed(3));
          scene.style.setProperty("--time-wash", nebulaSets[2] as string);
          scene.style.setProperty("--cosmic-saturation", cosmicSaturation.toFixed(3));
          scene.style.setProperty("--nebula-strength", nebulaStrength.toFixed(3));
          scene.style.setProperty("--day-radiance", daylight.toFixed(3));
          scene.style.setProperty("--twilight-radiance", twilight.toFixed(3));
          scene.style.setProperty("--vignette-strength", (0.7 - daylight * 0.42).toFixed(3));
          scene.style.setProperty("--horizon-strength", String(hour >= 8 && hour < 16 ? 0.34 : hour >= 16 && hour < 20 ? 0.68 : 0.86));
          scene.style.setProperty("--galaxy-angle", `${(cosmicDegrees - 188).toFixed(2)}deg`);
          scene.style.setProperty("--disc-angle", `${(cosmicDegrees - 228).toFixed(2)}deg`);
          scene.style.setProperty("--time-flow-x", `${timeFlowX.toFixed(2)}vw`);
          scene.style.setProperty("--time-flow-y", `${timeFlowY.toFixed(2)}vh`);
          scene.style.setProperty("--time-flow-x-inverse", `${(-timeFlowX).toFixed(2)}vw`);
          scene.style.setProperty("--time-flow-y-soft-inverse", `${(-timeFlowY * 0.7).toFixed(2)}vh`);
          scene.style.setProperty("--star-flow-x", `${starFlowX.toFixed(2)}vw`);
          scene.style.setProperty("--star-flow-y", `${starFlowY.toFixed(2)}vh`);
          scene.style.setProperty("--star-flow-x-near", `${(-starFlowX * 0.55).toFixed(2)}vw`);
          scene.style.setProperty("--star-flow-y-near", `${(-starFlowY * 0.55).toFixed(2)}vh`);
          scene.style.setProperty("--galaxy-scale", (1.02 + daylight * 0.12 + twilight * 0.04).toFixed(3));
          scene.style.setProperty("--star-flow-duration", `${starFlowDuration}s`);
          scene.style.setProperty("--near-star-flow-duration", `${Math.round(starFlowDuration * 0.68)}s`);
          scene.style.setProperty("--disc-star-flow-duration", `${Math.round(starFlowDuration * 0.72)}s`);
          scene.style.setProperty("--nebula-flow-duration", `${Math.round(42 - twilight * 12)}s`);
          scene.dataset.period = periodLabel(hour).toLowerCase();
          scrim.style.setProperty("--scrim", String(getScrim(hour)));
          document.body.classList.toggle("day", daylight > 0.74);
        };

        const backgroundMinutes = 0;
        const updatePanel = () => {
          const hour = Math.floor(backgroundMinutes / 60), minute = Math.floor(backgroundMinutes % 60);
          if (bgPanelTime) bgPanelTime.textContent = `${pad(hour)}:${pad(minute)}`; if (bgPanelPeriod) bgPanelPeriod.textContent = periodLabel(backgroundMinutes / 60); if (bgSlider) bgSlider.value = String(backgroundMinutes);
        };
        const weekdays = ["SUNDAY", "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY"], months = ["JANUARY", "FEBRUARY", "MARCH", "APRIL", "MAY", "JUNE", "JULY", "AUGUST", "SEPTEMBER", "OCTOBER", "NOVEMBER", "DECEMBER"];
        let lastMinute = -1;
        const tick = () => {
          const now = new Date();
          if (backgroundMinutes !== lastMinute) { lastMinute = backgroundMinutes; updateScene(backgroundMinutes); updatePanel(); }
          if (bigTime) bigTime.textContent = `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`; if (bigDate) bigDate.textContent = `${weekdays[now.getDay()]} · ${months[now.getMonth()]} ${now.getDate()}`; if (bigPeriod) bigPeriod.textContent = periodLabel(now.getHours());
        };
        tick(); intervals.push(window.setInterval(tick, 1000));
        let sliderFrame = 0;

        document.querySelectorAll<HTMLElement>("[data-copy]").forEach((button) => button.addEventListener("click", async () => {
          const value = button.dataset.copy ?? "";
          try { await navigator.clipboard.writeText(value); } catch { const input = document.createElement("textarea"); input.value = value; input.className = "copy-fallback"; document.body.appendChild(input); input.select(); document.execCommand("copy"); input.remove(); }
          if (copyStatus) { copyStatus.textContent = `${button.dataset.copyLabel ?? "内容"}已复制`; copyStatus.classList.add("show"); later(() => copyStatus.classList.remove("show"), 1400); }
        }, { signal: controller.signal }));

        const loader = document.getElementById("loader"), progress = document.getElementById("progress") as HTMLElement | null, progressText = document.getElementById("progressText"), loadingStatus = document.getElementById("loadingStatus"), welcome = document.getElementById("welcome"), welcomeCanvas = document.getElementById("welcomeParticles") as HTMLCanvasElement | null;
        const visitWindow = window as Window & { __archiveRouteInitialized?: boolean };
        const isReturningHome = Boolean(loader && visitWindow.__archiveRouteInitialized);
        visitWindow.__archiveRouteInitialized = true;
        const folders = Array.from(document.querySelectorAll<HTMLElement>(".folder"));
        const loaderStorageKey = "archive-home-loader-last-run";
        const loaderInterval = 30 * 60 * 1000;
        const isSmoothNetwork = () => {
          const connection = (navigator as Navigator & { connection?: { effectiveType?: string; downlink?: number; rtt?: number; saveData?: boolean } }).connection;
          if (!connection) return true;
          if (connection.saveData) return false;
          if (connection.effectiveType && /(^slow-2g$|^2g$|^3g$)/i.test(connection.effectiveType)) return false;
          if (typeof connection.downlink === "number" && connection.downlink > 0 && connection.downlink < 1.5) return false;
          if (typeof connection.rtt === "number" && connection.rtt > 450) return false;
          return true;
        };
        const shouldRunHomeLoader = () => {
          if (/^(localhost|127\.0\.0\.1)$/.test(window.location.hostname) && new URLSearchParams(window.location.search).has("preview")) return false;
          if (!isSmoothNetwork()) return true;
          try {
            const lastRun = Number(localStorage.getItem(loaderStorageKey) ?? "0");
            return !Number.isFinite(lastRun) || Date.now() - lastRun > loaderInterval;
          } catch {
            return true;
          }
        };
        const rememberHomeLoader = () => {
          try { localStorage.setItem(loaderStorageKey, String(Date.now())); } catch {}
        };
        const renderProgress = (value: number) => {
          const rounded = Math.max(0, Math.min(100, Math.round(value)));
          if (progress) progress.style.transform = `scaleX(${rounded / 100})`;
          if (progressText) progressText.textContent = `${rounded}%`;
          const activeIndex = rounded >= 100 ? folders.length : Math.min(folders.length - 1, Math.floor((rounded / 100) * folders.length));
          folders.forEach((folder, index) => {
            folder.classList.toggle("active", rounded < 100 && index === activeIndex);
            folder.classList.toggle("done", index < activeIndex || rounded >= 100);
          });
          const activeFolder = folders[activeIndex];
          if (loadingStatus && activeFolder && rounded < 100) loadingStatus.textContent = `loading /${activeFolder.dataset.folder?.toLowerCase()}`;
        };
        const revealHomeInStages = () => {
          document.body.classList.add("archive-ready", "heavy-warmup", "motion-warmup"); unlockPage();
          later(() => document.body.classList.remove("heavy-warmup"), 260);
          later(() => document.body.classList.remove("motion-warmup"), 760);
        };
        const animateProgress = (from: number, to: number, duration: number) => new Promise<void>((resolve) => {
          const start = performance.now(); const frame = (now: number) => { if (cancelled) return resolve(); const ratio = Math.min(1, (now - start) / duration); const eased = 1 - Math.pow(1 - ratio, 3); renderProgress(from + (to - from) * eased); if (ratio < 1) requestAnimationFrame(frame); else resolve(); }; requestAnimationFrame(frame);
        });
        const showWelcome = () => {
          if (!welcome) return; welcome.replaceChildren();
          Array.from("WELCOME").forEach((letter, index) => { const span = document.createElement("span"); span.className = "welcome-letter"; span.style.setProperty("--i", `${index * 0.07}s`); span.textContent = letter; welcome.appendChild(span); }); welcome.classList.add("show");
        };
        const disperseWelcome = () => {
          if (!welcome || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          if (!welcomeCanvas) return;
          const welcomeContext = welcomeCanvas.getContext("2d", { alpha: true });
          if (!welcomeContext) return;
          const palette = ["#ffffff", "#70e8ff", "#75a7ff", "#b989ff", "#ff75d8", "#ff7f9f", "#ffb65f", "#ffe074", "#73f5aa"];
          const perLetter = compactScreen ? 17 : lowPowerDevice ? 21 : 27;
          const pixelRatio = Math.min(window.devicePixelRatio || 1, 1.25);
          welcomeCanvas.width = Math.round(window.innerWidth * pixelRatio); welcomeCanvas.height = Math.round(window.innerHeight * pixelRatio);
          welcomeCanvas.style.width = `${window.innerWidth}px`; welcomeCanvas.style.height = `${window.innerHeight}px`;
          welcomeContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
          welcomeCanvas.classList.add("active");
          const welcomePoints: Array<{ x: number; y: number; vx: number; vy: number; size: number; life: number; maxLife: number; color: string }> = [];
          const letterData = Array.from(welcome.querySelectorAll<HTMLElement>(".welcome-letter"), (letter) => ({ letter, rect: letter.getBoundingClientRect() }));
          letterData.forEach(({ letter, rect }) => {
            letter.classList.add("dispersing");
            for (let index = 0; index < perLetter; index += 1) {
              const large = Math.random() < 0.16, angle = Math.random() * Math.PI * 2, distance = large ? 230 + Math.random() * 260 : 140 + Math.random() * 360;
              const maxLife = 1.25 + Math.random() * 0.48;
              welcomePoints.push({ x: rect.left + Math.random() * rect.width, y: rect.top + Math.random() * rect.height, vx: Math.cos(angle) * distance / maxLife, vy: Math.sin(angle) * distance / maxLife, size: large ? 5 + Math.random() * 3.5 : 1.8 + Math.random() * 3, life: maxLife, maxLife, color: palette[Math.floor(Math.random() * palette.length)] });
            }
          });
          let previous = performance.now();
          const renderWelcomeParticles = (now: number) => {
            const dt = Math.min((now - previous) / 1000, 0.034); previous = now;
            welcomeContext.clearRect(0, 0, window.innerWidth, window.innerHeight);
            welcomeContext.globalCompositeOperation = "lighter";
            for (let index = welcomePoints.length - 1; index >= 0; index -= 1) {
              const point = welcomePoints[index]; point.life -= dt; if (point.life <= 0) { welcomePoints.splice(index, 1); continue; }
              point.x += point.vx * dt; point.y += point.vy * dt; point.vx *= Math.exp(-0.42 * dt); point.vy *= Math.exp(-0.42 * dt);
              const life = point.life / point.maxLife;
              welcomeContext.globalAlpha = life * 0.2; welcomeContext.fillStyle = point.color; welcomeContext.beginPath(); welcomeContext.arc(point.x, point.y, point.size * 3.4, 0, Math.PI * 2); welcomeContext.fill();
              welcomeContext.globalAlpha = Math.min(1, life * 1.35); welcomeContext.beginPath(); welcomeContext.arc(point.x, point.y, point.size * (0.55 + life * 0.45), 0, Math.PI * 2); welcomeContext.fill();
            }
            welcomeContext.globalAlpha = 1; welcomeContext.globalCompositeOperation = "source-over";
            if (welcomePoints.length && !cancelled) welcomeFrame = window.requestAnimationFrame(renderWelcomeParticles);
            else { welcomeCanvas.classList.remove("active"); welcomeContext.clearRect(0, 0, window.innerWidth, window.innerHeight); }
          };
          window.cancelAnimationFrame(welcomeFrame); welcomeFrame = window.requestAnimationFrame(renderWelcomeParticles); welcome.classList.add("disappear");
        };
        const runLoader = async () => {
          if (!loader) { document.body.classList.add("archive-ready"); unlockPage(); return; }
          if (isReturningHome) {
            loader.classList.remove("archive-loading", "welcome-only");
            loader.classList.add("hide");
            document.body.classList.add("archive-ready", "home-returning");
            document.body.classList.remove("heavy-warmup", "motion-warmup");
            unlockPage();
            return;
          }
          if (!shouldRunHomeLoader()) {
            lockPage(); document.body.classList.remove("archive-ready"); loader.classList.remove("hide"); loader.classList.add("welcome-only");
            showWelcome(); await wait(820); disperseWelcome(); await wait(reduceMotion ? 180 : 1780);
            if (cancelled) return; loader.classList.remove("archive-loading", "welcome-only"); loader.classList.add("hide");
            revealHomeInStages();
            return;
          }
          lockPage(); document.body.classList.remove("archive-ready"); loader.classList.remove("hide"); loader.classList.add("archive-loading"); folders.forEach((folder) => folder.classList.remove("active", "done")); renderProgress(0); await wait(130);
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) { folders.forEach((folder) => folder.classList.add("done")); renderProgress(100); if (loadingStatus) loadingStatus.textContent = "project archive ready"; await wait(180); showWelcome(); await wait(520); }
          else {
            if (loadingStatus) loadingStatus.textContent = "loading tech stack";
            await animateProgress(0, 100, lowPowerDevice ? 620 : 760);
            folders.forEach((folder) => folder.classList.add("done"));
            if (loadingStatus) loadingStatus.textContent = "project archive ready";
            await wait(100); showWelcome(); await wait(840); disperseWelcome(); await wait(1780);
          }
          if (cancelled) return; rememberHomeLoader(); loader.classList.remove("archive-loading"); loader.classList.add("hide"); revealHomeInStages();
        };
        void runLoader();
        const globalBookLoader = document.getElementById("bookLoader");
        const closeGlobalBookLoader = () => { window.clearTimeout(globalArticleTimer); globalBookLoader?.classList.remove("show"); globalBookLoader?.setAttribute("aria-hidden", "true"); document.body.classList.remove("modal-open"); };
        const openArticleWithBook = (url: string) => {
          if (!url) return;
          document.body.classList.add("modal-open"); globalBookLoader?.classList.add("show"); globalBookLoader?.setAttribute("aria-hidden", "false");
          window.clearTimeout(globalArticleTimer); globalArticleTimer = window.setTimeout(() => {
            try { const destination = new URL(url, window.location.href); if (destination.origin === window.location.origin) void navigate(`${destination.pathname}${destination.search}${destination.hash}`); else window.location.href = destination.href; }
            catch { window.location.href = url; }
          }, reduceMotion ? 80 : 720);
        };
        window.addEventListener("archive:open-article", (event) => { const url = (event as CustomEvent<{ url?: string }>).detail?.url; if (url) openArticleWithBook(url); }, { signal: controller.signal });
        document.querySelectorAll<HTMLAnchorElement>("a[data-book-transition]").forEach((link) => link.addEventListener("click", (event) => {
          if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
          event.preventDefault(); openArticleWithBook(link.href);
        }, { signal: controller.signal }));
        window.addEventListener("pageshow", closeGlobalBookLoader, { signal: controller.signal });
        archiveCleanup = () => { cancelled = true; controller.abort(); galacticBackground.destroy(); window.clearTimeout(globalArticleTimer); window.cancelAnimationFrame(sliderFrame); window.cancelAnimationFrame(motionFrame); window.cancelAnimationFrame(welcomeFrame); timers.forEach(window.clearTimeout); intervals.forEach(window.clearInterval); unlockPage(); };
      };
      document.addEventListener("astro:page-load", initArchive);
      if (document.readyState === "complete") initArchive();
    </script>
  </body>
</html>
