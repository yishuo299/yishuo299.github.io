---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projectExperiences } from "../../data/projectExperiences";

export function getStaticPaths() {
  return projectExperiences.map((experience) => ({
    params: { slug: experience.slug },
    props: { experience },
  }));
}

const { experience } = Astro.props;
const firstRole = experience.roles[0];
const nativeSrc = `/experience-native/${experience.slug}/`;
---

<BaseLayout title={`${experience.title} · 项目体验`} description={experience.description} sideBarActiveItemID="experience">
  <section class="native-experience" data-native-root data-slug={experience.slug} data-native-src={nativeSrc}>
    <div class="native-toolbar">
      <a href="/experience/">← 项目体验</a>
      <div class="native-role-switch" aria-label="测试人员切换">
        {experience.roles.map((role, index) => (
          <button type="button" class:list={{ active: index === 0 }} data-native-role={role.key}>
            {role.label}
          </button>
        ))}
      </div>
      <div class="native-links">
        <a href={experience.articleUrl} data-book-transition>项目文章</a>
        <a href={experience.projectUrl} target="_blank" rel="noreferrer">前往项目</a>
      </div>
    </div>

    <div class="native-frame-shell">
      <div class="native-frame-header">
        <strong>{experience.title}</strong>
        <span>当前测试人员：<b data-native-current>{firstRole.label}</b></span>
      </div>
      <iframe
        title={`${experience.title} 原项目体验`}
        class="native-frame"
        data-native-frame
        src="about:blank"
        loading="eager"
      ></iframe>
    </div>
  </section>
</BaseLayout>

<script>
  let nativeCleanup: () => void = () => {};
  let initializedRoot: HTMLElement | null = null;

  const roleConfigs = {
    "hotel-booking": {
      mode: "hash",
      roles: {
        admin: { hash: "/dashboard", local: { hotel_token: "demo-token", hotel_user: { id: 1, username: "admin", realName: "系统管理员", role: "ADMIN", guestId: null } } },
        frontdesk: { hash: "/booking", local: { hotel_token: "demo-token", hotel_user: { id: 2, username: "front01", realName: "前台王秀兰", role: "FRONTDESK", guestId: null } } },
        guest: { hash: "/browse", local: { hotel_token: "demo-token", hotel_user: { id: 10, username: "guest01", realName: "客人张伟", role: "GUEST", guestId: 1 } } },
      },
    },
    "property-management": {
      mode: "hash",
      roles: {
        admin: { hash: "/dashboard", local: { token: "demo-token", userInfo: { id: 1, username: "admin", realName: "系统管理员", role: "ADMIN" } } },
        staff: { hash: "/my-orders", local: { token: "demo-token", userInfo: { id: 2, username: "staff01", realName: "维修员王师傅", role: "STAFF" } } },
        owner: { hash: "/my-repairs", local: { token: "demo-token", userInfo: { id: 10, username: "owner01", realName: "业主张伟", role: "OWNER", ownerId: 1 } } },
      },
    },
    "campus-marketplace": {
      mode: "hash",
      roles: {
        buyer: { hash: "/", local: { token: "demo-token", userInfo: { id: 1, username: "buyer", realName: "测试买家", role: "USER" } } },
        seller: { hash: "/seller", local: { token: "demo-token", userInfo: { id: 2, username: "seller", realName: "测试卖家", role: "USER" } } },
        admin: { hash: "/admin", local: { token: "demo-token", userInfo: { id: 9, username: "admin", realName: "测试管理员", role: "ADMIN" } } },
      },
    },
    "clinic-appointment": {
      mode: "hash",
      roles: {
        patient: { hash: "/appointment", local: { token: "demo-token", userInfo: { id: 1, username: "patient", realName: "测试患者", role: "PATIENT" } } },
        doctor: { hash: "/dashboard", local: { token: "demo-token", userInfo: { id: 2, username: "doctor", realName: "测试医生", role: "DOCTOR", doctorId: 1 } } },
        admin: { hash: "/dashboard", local: { token: "demo-token", userInfo: { id: 3, username: "admin", realName: "医务管理员", role: "ADMIN" } } },
      },
    },
    "library-management": {
      mode: "hash",
      roles: {
        reader: { hash: "/books", local: { token: "demo-token", userInfo: { id: 1, username: "reader", realName: "测试读者", role: "READER" } } },
        librarian: { hash: "/borrows", local: { token: "demo-token", userInfo: { id: 2, username: "librarian", realName: "测试馆员", role: "LIBRARIAN" } } },
        admin: { hash: "/dashboard", local: { token: "demo-token", userInfo: { id: 3, username: "admin", realName: "系统管理员", role: "ADMIN" } } },
      },
    },
    "movie-recommend": {
      mode: "hash",
      roles: {
        user: { hash: "/", local: { token: "demo-token", userInfo: { id: 1, username: "movie_user", realName: "测试用户", role: "USER" } } },
        admin: { hash: "/dashboard", local: { token: "demo-token", userInfo: { id: 2, username: "movie_admin", realName: "测试管理员", role: "ADMIN" } } },
      },
    },
    "face-attendance": {
      mode: "hash",
      roles: {
        student: { hash: "/face-sign", local: { token: "demo-token", userInfo: { id: 1, username: "student", realName: "测试学生", role: "STUDENT", studentId: 1 } } },
        teacher: { hash: "/session", local: { token: "demo-token", userInfo: { id: 2, username: "teacher", realName: "测试教师", role: "TEACHER", teacherId: 1 } } },
        admin: { hash: "/dashboard", local: { token: "demo-token", userInfo: { id: 3, username: "admin", realName: "系统管理员", role: "ADMIN" } } },
      },
    },
    "course-selection": {
      mode: "history-session",
      roles: {
        student: { path: "/student/dashboard", session: { token: "demo-token", userInfo: { userId: 1, username: "student", realName: "测试学生", userType: 1, roles: ["ROLE_STUDENT"], streamType: 1 } } },
        teacher: { path: "/teacher/dashboard", session: { token: "demo-token", userInfo: { userId: 2, username: "teacher", realName: "测试教师", userType: 2, roles: ["ROLE_TEACHER"] } } },
        academic: { path: "/academic/dashboard", session: { token: "demo-token", userInfo: { userId: 3, username: "academic", realName: "教务管理员", userType: 3, roles: ["ROLE_ACADEMIC_ADMIN"] } } },
        admin: { path: "/admin/dashboard", session: { token: "demo-token", userInfo: { userId: 4, username: "admin", realName: "系统管理员", userType: 4, roles: ["ROLE_SYSTEM_ADMIN"] } } },
      },
    },
    "equipment-system": {
      mode: "history-local",
      roles: {
        admin: { path: "/admin", local: { user: { id: 1, username: "admin", fullName: "系统管理员", role: "ADMIN" } } },
        user: { path: "/user", local: { user: { id: 2, username: "user1", fullName: "普通用户", role: "USER" } } },
        worker: { path: "/worker", local: { user: { id: 3, username: "worker1", fullName: "维保工程师", role: "WORKER" } } },
      },
    },
    "parking-management": {
      mode: "hash",
      roles: {
        admin: { hash: "/", local: { token: "demo-token", userInfo: { id: 1, username: "admin", realName: "系统管理员", role: "ADMIN" } } },
        operator: { hash: "/exit", local: { token: "demo-token", userInfo: { id: 2, username: "operator01", realName: "收费员李静", role: "OPERATOR" } } },
        owner: { hash: "/owner/vehicles", local: { token: "demo-token", userInfo: { id: 3, username: "owner01", realName: "车主陈晓明", role: "OWNER" } } },
      },
    },
    "personal-finance": {
      mode: "hash",
      roles: {
        zhangsan: { hash: "/dashboard", local: { pf_token: "demo-token", pf_user: { id: 2, username: "zhangsan", realName: "张伟", role: "USER", status: 1 } } },
        lisi: { hash: "/bills", local: { pf_token: "demo-token", pf_user: { id: 3, username: "lisi", realName: "李娜", role: "USER", status: 1 } } },
        admin: { hash: "/users", local: { pf_token: "demo-token", pf_user: { id: 1, username: "admin", realName: "系统管理员", role: "ADMIN", status: 1 } } },
      },
    },
    "hr-management": {
      mode: "hash",
      roles: {
        admin: { hash: "/dashboard", local: { hr_token: "demo-token", hr_user: { userId: 1, username: "admin", realName: "系统管理员", role: "ADMIN", employeeId: null, deptId: null } } },
        hr: { hash: "/employee/list", local: { hr_token: "demo-token", hr_user: { userId: 2, username: "hr01", realName: "人事专员王雅", role: "HR", employeeId: 4, deptId: 7 } } },
        manager: { hash: "/leave/todo", local: { hr_token: "demo-token", hr_user: { userId: 3, username: "mgr01", realName: "研发经理李建", role: "MANAGER", employeeId: 1, deptId: 2 } } },
        employee: { hash: "/my/attendance", local: { hr_token: "demo-token", hr_user: { userId: 4, username: "emp01", realName: "员工张伟", role: "EMPLOYEE", employeeId: 2, deptId: 3 } } },
      },
    },
    "research-management": {
      mode: "static",
      roles: {
        secretary: { query: "?role=secretary" },
        teacher: { query: "?role=teacher" },
        admin: { query: "?role=admin" },
      },
    },
  } as const;

  const writeStorage = (payload: Record<string, unknown>, storage: Storage) => {
    Object.entries(payload).forEach(([key, value]) => {
      storage.setItem(key, typeof value === "string" ? value : JSON.stringify(value));
    });
  };

  const srcForRole = (base: string, config: any, roleConfig: any, key: string) => {
    const stamp = `mockRole=${encodeURIComponent(key)}`;
    if (config.mode === "hash") return `${base}?${stamp}#${roleConfig.hash}`;
    if (config.mode === "static") return `${base}${roleConfig.query ?? ""}`;
    if (config.mode === "history-session" || config.mode === "history-local") {
      return `${base}?${stamp}&experienceRoute=${encodeURIComponent(roleConfig.path)}`;
    }
    return base;
  };

  const initNativeExperience = () => {
    const root = document.querySelector<HTMLElement>("[data-native-root]");
    if (root && initializedRoot === root) return;
    nativeCleanup();
    const controller = new AbortController();
    const frame = root?.querySelector<HTMLIFrameElement>("[data-native-frame]");
    if (!root || !frame) return;
    initializedRoot = root;

    const slug = root.dataset.slug ?? "";
    const base = root.dataset.nativeSrc ?? "";
    const config = (roleConfigs as any)[slug];
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-native-role]"));
    const current = root.querySelector<HTMLElement>("[data-native-current]");
    let activeKey = "";

    const activate = (button: HTMLButtonElement) => {
      const key = button.dataset.nativeRole ?? "";
      const roleConfig = config?.roles?.[key];
      if (!roleConfig || key === activeKey) return;
      activeKey = key;
      buttons.forEach((item) => item.classList.toggle("active", item === button));
      if (current) current.textContent = button.textContent ?? "";
      ["token", "userInfo", "user", "rolePermissionMap", "roleEdits", "pf_token", "pf_user", "hr_token", "hr_user", "hotel_token", "hotel_user"].forEach((name) => {
        window.localStorage.removeItem(name);
        window.sessionStorage.removeItem(name);
      });
      if (roleConfig.local) writeStorage(roleConfig.local, window.localStorage);
      if (roleConfig.session) writeStorage(roleConfig.session, window.sessionStorage);
      frame.src = srcForRole(base, config, roleConfig, key);
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => activate(button), { signal: controller.signal });
    });

    const active = buttons.find((button) => button.classList.contains("active")) ?? buttons[0];
    if (active) activate(active);

    nativeCleanup = () => { controller.abort(); initializedRoot = null; };
  };

  document.addEventListener("astro:before-swap", () => nativeCleanup());
  document.addEventListener("astro:page-load", initNativeExperience);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initNativeExperience, { once: true });
  } else {
    initNativeExperience();
  }
</script>
