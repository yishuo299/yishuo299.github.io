---
import BaseLayout from "../layouts/BaseLayout.astro";
import projects from "../data/projects.json";
import { FALLBACK_TECH_META, TECH_META } from "../data/techMeta";

const techColors = Object.fromEntries(Object.entries(TECH_META).map(([name, meta]) => [name, meta.color]));
const getTechMeta = (tag: string) => TECH_META[tag] ?? TECH_META[tag.replace(/\s*\d+$/, "")] ?? FALLBACK_TECH_META;
const latestProjects = projects.slice(0, 6);
const CATEGORY_STARS = [
  { name: "Python", x: 88, y: 50, size: 78, orbitX: 0.39, orbitY: 0.27, phase: 0, speed: 0.041 },
  { name: "STM32", x: 69, y: 27, size: 68, orbitX: 0.39, orbitY: 0.27, phase: Math.PI / 3, speed: 0.041 },
  { name: "Django", x: 31, y: 27, size: 84, orbitX: 0.39, orbitY: 0.27, phase: (Math.PI * 2) / 3, speed: 0.041 },
  { name: "Vue", x: 12, y: 50, size: 68, orbitX: 0.39, orbitY: 0.27, phase: Math.PI, speed: 0.041 },
  { name: "Spring Boot", x: 31, y: 73, size: 90, orbitX: 0.39, orbitY: 0.27, phase: (Math.PI * 4) / 3, speed: 0.041 },
  { name: "Android", x: 69, y: 73, size: 72, orbitX: 0.39, orbitY: 0.27, phase: (Math.PI * 5) / 3, speed: 0.041 },
].map((category) => ({
  ...category,
  meta: getTechMeta(category.name),
  count: projects.filter((project) => [project.name, ...project.tags].includes(category.name)).length,
}));
const PROJECT_STARS = projects.map((project, index) => {
  const angle = (index * 137.508 * Math.PI) / 180;
  const ring = 0.16 + (index % 4) * 0.055;
  return {
    name: project.title,
    x: 50 + Math.cos(angle) * ring * 100,
    y: 50 + Math.sin(angle) * ring * 68,
    size: 15 + (index % 4) * 4,
    color: getTechMeta(project.tags[0] ?? project.name).color,
    delay: index * -0.73,
    dx: 8 + (index % 4) * 3,
    dy: 5 + ((index + 2) % 4) * 2,
    duration: 7.5 + (index % 5) * 1.1,
  };
});
---

<BaseLayout sideBarActiveItemID="home">
  <section id="home" class="hero-section">
    <div class="container">
      <div class="archive-hero">
        <div class="hero-profile">
          <div class="holo-avatar-shell" aria-label="燚燿全息头像卡片">
            <div class="holo-avatar-card holo-avatar-live-card">
              <iframe
                class="holo-avatar-frame"
                src="/holo-avatar-web/?v=20260921-4"
                title="燚燿全息头像卡片"
                loading="eager"
              ></iframe>
            </div>
          </div>
          <div class="profile-name">燚燿</div>
          <div class="profile-role">DEVELOPER / BUILDER / LEARNER</div>
          <div class="social-links">
            <a class="social-link" href="https://github.com/yishuo299" target="_blank" rel="noreferrer" aria-label="访问 GitHub yishuo299">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.26-1.28-5.26-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.9-.39.98 0 1.98.13 2.9.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.27 5.68.41.35.78 1.04.78 2.1 0 1.52-.01 2.75-.01 3.12 0 .31.21.67.8.56A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" /></svg>
              <span>GitHub</span><small>yishuo299</small>
            </a>
            <button class="social-link" type="button" data-copy="3441125143" data-copy-label="QQ 号" aria-label="复制 QQ 号 3441125143">
              <span class="social-mark" aria-hidden="true">Q</span><span>QQ</span><small>3441125143</small>
            </button>
            <button class="social-link" type="button" data-copy="yy_shuo_299" data-copy-label="微信号" aria-label="复制微信号 yy_shuo_299">
              <span class="social-mark" aria-hidden="true">微</span><span>微信</span><small>yy_shuo_299</small>
            </button>
          </div>
        </div>

        <div class="hero-message">
          <div class="hero-small">PERSONAL PROJECT ARCHIVE</div>
          <h1>Build.<br />Learn.<br />Repeat.</h1>
          <p class="hero-description"><strong>记录项目，也记录成长。</strong><br />把想法变成项目，把项目变成经验。</p>
          <div class="hero-actions">
            <a class="archive-button" href="https://github.com/yishuo299" target="_blank" rel="noreferrer">GitHub ↗</a>
            <a class="archive-button" href="/experience/">项目体验</a>
          </div>
        </div>
      </div>

      <div class="hero-clock">
        <div class="hero-clock-row">
          <div class="big-time" id="bigTime">00:00:00</div>
        </div>
        <div class="big-date" id="bigDate">LOADING LOCAL TIME</div>
        <div class="big-period" id="bigPeriod">LOCAL TIME</div>
      </div>
    </div>
  </section>

  <section id="constellation" class="constellation-section" aria-label="项目技术分类星图">
    <div class="container">
      <div class="constellation-map reveal" aria-label="项目技术分类星图">
        <div class="project-star-field" aria-hidden="true">
          {PROJECT_STARS.map((star) => (
            <i
              class="project-satellite"
              title={star.name}
              style={`--satellite-x:${star.x.toFixed(2)}%;--satellite-y:${star.y.toFixed(2)}%;--satellite-size:${star.size}px;--satellite-color:${star.color};--satellite-delay:${star.delay}s;--satellite-dx:${star.dx}px;--satellite-dx-neg:${-star.dx}px;--satellite-dy:${star.dy}px;--satellite-dy-neg:${-star.dy}px;--satellite-duration:${star.duration}s`}
            ></i>
          ))}
        </div>
        <div class="constellation-core" aria-hidden="true"><span></span><small>PROJECT<br />UNIVERSE</small></div>
        <div class="orbit-line orbit-line-one" aria-hidden="true"></div>
        <div class="orbit-line orbit-line-two" aria-hidden="true"></div>
        <div class="orbit-line orbit-line-three" aria-hidden="true"></div>
        {CATEGORY_STARS.map((category, index) => (
          <a
            class:list={["category-star", { "label-left": category.x > 60 }]}
            href={`/projects/?tech=${encodeURIComponent(category.name)}`}
            data-category-star
            data-category={category.name}
            data-orbit-x={category.orbitX}
            data-orbit-y={category.orbitY}
            data-orbit-phase={category.phase}
            data-orbit-speed={category.speed}
            style={`--star-x:${category.x}%;--star-y:${category.y}%;--star-size:${category.size}px;--star-color:${category.meta.color};--star-delay:${index * -1.7}s`}
            aria-label={`查看 ${category.name} 分类，共 ${category.count} 个项目`}
          >
            <span class="category-star-orbit"></span>
            <span class="category-star-core"><span set:html={category.meta.svg}></span></span>
            <span class="category-star-label"><strong>{category.name}</strong></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="projects" class="content-section">
    <div class="container">
      <header class="section-heading reveal">
        <div><div class="section-label">SELECTED WORK</div><h2 class="section-title">Projects</h2></div>
        <a class="section-link" href="/projects/">查看全部 {String(projects.length).padStart(2, "0")} 篇项目文章 ↗</a>
      </header>

      <div class="projects-list" id="projectsContainer">
        {latestProjects.map((project, index) => (
          <div class="reveal project-item" data-project-category={`|${[project.name, ...project.tags].map((tag) => tag.toLowerCase()).join("|")}|`} data-project-search={`${project.name} ${project.title} ${project.description} ${project.tags.join(" ")}`.toLowerCase()} style={`--delay:${(index % 3) * 70}ms;--project-color:${techColors[project.name] ?? "#8ab4ff"}`}>
            <button class="project-card" type="button" data-project-card data-name={project.name} data-title={project.title} data-description={project.description} data-detail={project.detail} data-article={(project as any).articleUrl ?? ""} data-project-url={(project as any).projectUrl ?? ""} data-icon={getTechMeta(project.tags[0] ?? project.name).svg}>
              <span class="project-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <span class="project-body">
                <span class="project-top"><span class="project-keyword">{project.name}</span></span>
                <strong class="project-title">{project.title}</strong>
                <span class="project-description">{project.description}</span>
                <span class="project-footer">{project.tags.map((tag) => <span class="tech-tag">{tag}</span>)}</span>
              </span>
              <span class="project-aside" aria-hidden="true">
                <span class="project-tech-icon" set:html={getTechMeta(project.tags[0] ?? project.name).svg}></span>
                <span class="project-open">OPEN <span>↗</span></span>
              </span>
            </button>
          </div>
        ))}
      </div>
      <div class="no-result" id="noResult">NO PROJECT FOUND</div>
    </div>
  </section>

  <section id="about" class="content-section">
    <div class="container">
      <header class="section-heading reveal"><div><div class="section-label">ABOUT</div><h2 class="section-title">Build · Learn · Repeat</h2></div></header>
      <p class="about-text reveal">这里是我的个人项目档案。我喜欢通过实际项目学习新技术，从 Python、Web 开发，到 STM32 嵌入式开发、Android 与前后端项目。每一个项目都是一次实践，也记录着不断尝试、学习和成长的过程。</p>
    </div>
  </section>

  <div id="blackHoleTransition" class="black-hole-transition" aria-hidden="true">
    <div class="black-hole-lens"><i></i><span></span></div>
    <div class="black-hole-shards" aria-hidden="true">{Array.from({ length: 14 }, (_, index) => <i data-hole-shard style={`--shard-index:${index}`}></i>)}</div>
    <div class="black-hole-label" id="blackHoleLabel">ENTERING ORBIT</div>
  </div>
</BaseLayout>

<script>
  import { navigate } from "astro:transitions/client";

  let homeCleanup: () => void = () => {};

  const initHome = () => {
    homeCleanup();
    const root = document.getElementById("projectsContainer");
    if (!root) return;

    const controller = new AbortController();
    const projectItems = Array.from(document.querySelectorAll<HTMLElement>(".project-item"));
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-project-filter]"));
    const searchButton = document.getElementById("searchButton");
    const searchWrapper = document.getElementById("searchWrapper");
    const searchInput = document.getElementById("searchInput") as HTMLInputElement | null;
    const filterButton = document.getElementById("filterButton");
    const filterPanel = document.getElementById("filterPanel");
    const toolbarStatus = document.getElementById("toolbarStatus");
    const noResult = document.getElementById("noResult");
    const initialParams = new URLSearchParams(window.location.search);
    const initialFilter = initialParams.get("tech")?.toLowerCase() ?? "all";
    let activeFilter = filterButtons.some((button) => (button.dataset.projectFilter ?? "").toLowerCase() === initialFilter) ? initialFilter : "all";
    if (searchInput) searchInput.value = initialParams.get("q") ?? "";
    filterButtons.forEach((button) => button.classList.toggle("active", (button.dataset.projectFilter ?? "all").toLowerCase() === activeFilter));

    const syncFilterUrl = () => {
      const params = new URLSearchParams(window.location.search);
      const keyword = searchInput?.value.trim() ?? "";
      if (activeFilter === "all") params.delete("tech"); else params.set("tech", activeFilter);
      if (keyword) params.set("q", keyword); else params.delete("q");
      const query = params.toString();
      window.history.replaceState({}, "", `${window.location.pathname}${query ? `?${query}` : ""}${window.location.hash}`);
    };

    const applyFilters = (updateUrl = false) => {
      const keyword = searchInput?.value.trim().toLowerCase() ?? "";
      let visible = 0;
      projectItems.forEach((item) => {
        const categoryMatches = activeFilter === "all" || (item.dataset.projectCategory ?? "").includes(`|${activeFilter.toLowerCase()}|`);
        const searchMatches = !keyword || (item.dataset.projectSearch ?? "").includes(keyword);
        const matches = categoryMatches && searchMatches;
        item.classList.toggle("hidden", !matches);
        if (matches) visible += 1;
      });
      noResult?.classList.toggle("show", visible === 0);
      if (toolbarStatus) toolbarStatus.textContent = activeFilter === "all" ? (keyword ? `SEARCH: ${keyword.toUpperCase()}` : "ALL PROJECTS") : `FILTER: ${activeFilter.toUpperCase()}`;
      if (updateUrl) syncFilterUrl();
    };

    searchButton?.addEventListener("click", () => { searchWrapper?.classList.toggle("open"); if (searchWrapper?.classList.contains("open")) window.setTimeout(() => searchInput?.focus(), 220); }, { signal: controller.signal });
    searchInput?.addEventListener("input", () => applyFilters(true), { signal: controller.signal });
    filterButton?.addEventListener("click", () => { const open = !filterPanel?.classList.contains("open"); filterPanel?.classList.toggle("open", open); filterButton.setAttribute("aria-expanded", String(open)); }, { signal: controller.signal });
    filterButtons.forEach((button) => button.addEventListener("click", () => { activeFilter = (button.dataset.projectFilter ?? "all").toLowerCase(); filterButtons.forEach((item) => item.classList.toggle("active", item === button)); applyFilters(true); }, { signal: controller.signal }));
    applyFilters();

    const revealObserver = "IntersectionObserver" in window ? new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add("in-view"); revealObserver.unobserve(entry.target); } }), { threshold: 0.1, rootMargin: "0px 0px -36px" }) : null;
    document.querySelectorAll(".reveal").forEach((element) => revealObserver ? revealObserver.observe(element) : element.classList.add("in-view"));

    const blackHoleTransition = document.getElementById("blackHoleTransition");
    const blackHoleLabel = document.getElementById("blackHoleLabel");
    const holeShards = Array.from(document.querySelectorAll<HTMLElement>("[data-hole-shard]"));
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const constellationMap = document.querySelector<HTMLElement>(".constellation-map");
    const orbitStars = Array.from(document.querySelectorAll<HTMLElement>("[data-category-star]"));
    const staticOrbit = reducedMotion || window.matchMedia("(max-width: 500px)").matches;
    let orbitFrame = 0;
    let orbitWidth = constellationMap?.clientWidth ?? 0;
    let orbitHeight = constellationMap?.clientHeight ?? 0;
    let orbitVisible = true;
    const orbitResizeObserver = constellationMap && "ResizeObserver" in window ? new ResizeObserver(() => {
      orbitWidth = constellationMap.clientWidth;
      orbitHeight = constellationMap.clientHeight;
    }) : null;
    const orbitVisibilityObserver = constellationMap && "IntersectionObserver" in window ? new IntersectionObserver(([entry]) => {
      orbitVisible = entry.isIntersecting;
    }, { rootMargin: "180px" }) : null;
    if (constellationMap && !staticOrbit) {
      constellationMap.classList.add("is-orbiting");
      orbitResizeObserver?.observe(constellationMap);
      orbitVisibilityObserver?.observe(constellationMap);
      const animateOrbits = (now: number) => {
        if (orbitVisible && !document.hidden && document.body.classList.contains("archive-ready") && !document.body.classList.contains("cosmic-transitioning")) {
          const elapsed = now / 1000;
          orbitStars.forEach((star) => {
            const radiusX = Number(star.dataset.orbitX ?? 0.34) * orbitWidth;
            const radiusY = Number(star.dataset.orbitY ?? 0.24) * orbitHeight;
            const phase = Number(star.dataset.orbitPhase ?? 0);
            const speed = Number(star.dataset.orbitSpeed ?? 0.05);
            const angle = phase + elapsed * speed;
            const depth = (Math.sin(angle) + 1) / 2;
            const x = Math.cos(angle) * radiusX;
            const y = Math.sin(angle) * radiusY;
            const scale = 0.68 + depth * 0.44;
            star.style.transform = `translate(-50%,-50%) translate3d(${x.toFixed(2)}px,${y.toFixed(2)}px,${(depth * 140).toFixed(1)}px) scale(${scale.toFixed(3)})`;
            star.style.opacity = String(0.62 + depth * 0.38);
            star.style.zIndex = String(3 + Math.round(depth * 9));
            star.style.setProperty("--orbit-depth", depth.toFixed(3));
            star.style.setProperty("--planet-light", (0.72 + depth * 0.4).toFixed(3));
          });
        }
        orbitFrame = window.requestAnimationFrame(animateOrbits);
      };
      orbitFrame = window.requestAnimationFrame(animateOrbits);
    }
    document.querySelectorAll<HTMLAnchorElement>("[data-category-star]").forEach((star) => {
      star.addEventListener("click", (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
        event.preventDefault();
        const destination = star.href;
        if (reducedMotion || !blackHoleTransition) { void navigate(destination); return; }
        const rect = star.getBoundingClientRect();
        const holeX = rect.left + rect.width / 2;
        const holeY = rect.top + rect.height / 2;
        blackHoleTransition.style.setProperty("--hole-x", `${holeX}px`);
        blackHoleTransition.style.setProperty("--hole-y", `${holeY}px`);
        if (blackHoleLabel) blackHoleLabel.textContent = `ENTERING ${(star.dataset.category ?? "ORBIT").toUpperCase()}`;
        holeShards.forEach((shard, index) => {
          const angle = (Math.PI * 2 * index) / holeShards.length + (index % 3) * 0.19;
          const distance = Math.max(window.innerWidth, window.innerHeight) * (0.46 + (index % 7) * 0.055);
          const startX = holeX + Math.cos(angle) * distance;
          const startY = holeY + Math.sin(angle) * distance;
          shard.style.left = `${startX}px`;
          shard.style.top = `${startY}px`;
          shard.style.setProperty("--suck-x", `${holeX - startX}px`);
          shard.style.setProperty("--suck-y", `${holeY - startY}px`);
          shard.style.setProperty("--shard-delay", `${(index % 8) * 18}ms`);
        });
        blackHoleTransition.classList.add("show");
        blackHoleTransition.setAttribute("aria-hidden", "false");
        document.body.classList.add("cosmic-transitioning");
        window.cancelAnimationFrame(orbitFrame);
        window.setTimeout(() => { void navigate(destination); }, 640);
      }, { signal: controller.signal });
    });

    const openArticle = (card: HTMLElement) => {
      const articleUrl = card.dataset.article ?? "";
      if (articleUrl) window.dispatchEvent(new CustomEvent("archive:open-article", { detail: { url: articleUrl } }));
    };
    document.querySelectorAll<HTMLElement>("[data-project-card]").forEach((card) => {
      card.addEventListener("click", () => openArticle(card), { signal: controller.signal });
      const articleUrl = card.dataset.article;
      if (articleUrl) card.addEventListener("pointerenter", () => {
        if (document.head.querySelector(`link[data-project-prefetch="${CSS.escape(articleUrl)}"]`)) return;
        const prefetch = document.createElement("link"); prefetch.rel = "prefetch"; prefetch.href = articleUrl; prefetch.dataset.projectPrefetch = articleUrl; document.head.appendChild(prefetch);
      }, { signal: controller.signal, once: true, passive: true });
    });

    homeCleanup = () => { controller.abort(); window.cancelAnimationFrame(orbitFrame); revealObserver?.disconnect(); orbitResizeObserver?.disconnect(); orbitVisibilityObserver?.disconnect(); document.body.classList.remove("modal-open", "cosmic-transitioning"); };
  };

  document.addEventListener("astro:page-load", initHome);
  if (document.readyState === "complete") initHome();
</script>
