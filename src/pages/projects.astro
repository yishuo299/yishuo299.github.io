---
import BaseLayout from "../layouts/BaseLayout.astro";
import projects from "../data/projects.json";

const techColors: Record<string, string> = {
  Python: "#3776ab",
  STM32: "#4f8cff",
  Django: "#44b78b",
  Vue: "#42b883",
  "Spring Boot": "#6db33f",
  Android: "#3ddc84",
};
---

<BaseLayout title="项目" sideBarActiveItemID="projects">
  <section class="standalone-section">
    <header class="page-heading">
      <div class="section-label">PROJECT ARCHIVE</div>
      <h1>Projects</h1>
      <p>按技术栈整理的项目实践与学习记录。</p>
    </header>

    <div class="standalone-projects">
      {projects.map((project, index) => (
        <article class="standalone-card" style={`--project-color:${techColors[project.name] ?? "#8ab4ff"}`}>
          <div class="project-top"><span class="project-index">{String(index + 1).padStart(2, "0")} / {String(projects.length).padStart(2, "0")}</span><span class="project-keyword">{project.name}</span></div>
          <h2>{project.title}</h2>
          <p>{project.description}</p>
          <p class="project-detail">{project.detail}</p>
          {(project as any).articleUrl && <a class="project-read-link" href={(project as any).articleUrl}>阅读完整文章 ↗</a>}
          <div class="project-footer">{project.tags.map((tag) => <span class="tech-tag">{tag}</span>)}</div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
