---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "项目" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">项目归档</div>
  </div>

  <HorizontalCard
    title="智能工具 · 工作流自动化"
    img="/post_img.webp"
    desc="用代码把重复工作变得简单高效。"
    url="#"
    badge="精选"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="数据看板 · 可视化实践"
    img="/post_img.webp"
    desc="关注数据，也关注数据背后的故事。"
    url="#"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">更多实验</div>
  </div>

  <HorizontalCard
    title="开源实验 · 组件与工具"
    img="/post_img.webp"
    desc="记录学习过程，分享可复用的解决方案。"
    url="#"
    badge="开源"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="个人网站 · Astro 作品集"
    img="/post_img.webp"
    desc="一个持续更新的个人项目与成长档案。"
    url="#"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="下一件作品 · 敬请期待"
    img="/post_img.webp"
    desc="保持好奇，持续构建。"
    url="#"
  />
</BaseLayout>
