---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { codeSections, modules, projectUrl, screenshots, techStack } from "../../data/courseSelectionArticleData";

const dataTables = [
  ["user / role / permission", "保存账号、角色和权限，是系统访问控制的基础。"],
  ["course / course_offering", "课程表示课程本身，开课表示某学期某教师开设的具体课程。"],
  ["course_selection", "保存学生选课记录，是课表和成绩的来源。"],
  ["grade", "保存分项成绩、总评成绩、绩点、审核状态和发布状态。"],
  ["operation_log", "记录关键操作，支持后台审计和问题排查。"],
];
---

<BaseLayout sideBarActiveItemID="projects">
  <main class="blueprint-article">
    <a class="back-link" href="/#projects">← 返回项目列表</a>

    <section class="blueprint-hero">
      <p class="eyebrow">Template 03 · 工程蓝图型</p>
      <div class="title-row">
        <h1>从数据库到接口，复现一套选课系统</h1>
        <a href={projectUrl} target="_blank" rel="noreferrer">前往项目 ↗</a>
      </div>
      <p>这篇文章从工程实现角度展开：先看数据模型，再看业务流程，然后看接口和关键代码。读者可以按这个顺序复现项目，而不是只停留在页面效果。</p>
    </section>

    <section class="map-section">
      <h2>一、项目介绍：先确定系统边界</h2>
      <p>选课系统的边界可以概括为五句话：管理员维护用户和权限；教务维护课程资源；学生完成选课并生成课表；教师录入成绩；教务审核后发布成绩。只要这五条链路能跑通，系统就具备了基本可用性。</p>
      <div class="module-map">{modules.map(([name, desc]) => <div><b>{name}</b><span>{desc}</span></div>)}</div>
    </section>

    <section class="data-first">
      <h2>二、数据表设计</h2>
      <p>工程复现建议从数据表开始，因为选课系统的多数功能都依赖数据关系。课程和开课要拆开，选课记录要关联具体开课，成绩要关联选课记录，日志要独立保存操作信息。</p>
      <div>{dataTables.map(([name, desc]) => <article><strong>{name}</strong><p>{desc}</p></article>)}</div>
    </section>

    <section class="tech-blueprint">
      <h2>三、技术栈分层</h2>
      <div class="layers">{techStack.map(([name, desc]) => <div><span>{name}</span><p>{desc}</p></div>)}</div>
    </section>

    <section class="build-order">
      <h2>四、推荐实现顺序</h2>
      <ol>
        <li><strong>基础框架：</strong>搭建 Spring Boot 后端、Vue 前端和 MySQL 数据库。</li>
        <li><strong>登录权限：</strong>完成登录接口、JWT 拦截器、路由守卫和角色菜单。</li>
        <li><strong>课程开设：</strong>完成课程、学期、教师、教室和开课记录管理。</li>
        <li><strong>学生选课：</strong>完成课程列表、选课提交、退课和课表查询。</li>
        <li><strong>成绩管理：</strong>完成成绩录入、总评计算、教务审核和学生查询。</li>
        <li><strong>后台维护：</strong>完成用户权限管理和操作日志查询。</li>
      </ol>
    </section>

    <section class="code-board">
      <h2>五、关键代码段</h2>
      <p>下面的代码按工程实现顺序排列。每一段都说明使用的方法和在项目中的作用，方便读者把文章内容和项目文件对应起来。</p>
      <div class="code-grid">
        {codeSections.map((item) => (
          <article>
            <header><span>{item.title}</span><p>{item.method}</p></header>
            <pre><code>{item.code}</code></pre>
            <footer>{item.purpose}</footer>
          </article>
        ))}
      </div>
    </section>

    <section class="result-section">
      <h2>六、项目运行结果</h2>
      <p>项目运行后，核心结果可以从两个角度验证：业务流程是否能跑通，后台维护是否可用。业务流程包括登录、开课、选课、课表、成绩录入和成绩查询；后台维护包括用户管理、权限管理和操作日志。</p>
      <div class="result-grid">{screenshots.map((shot) => <figure><img src={shot.src} alt={shot.title} loading="lazy" /><figcaption><strong>{shot.title}</strong><span>{shot.desc}</span></figcaption></figure>)}</div>
    </section>

    <section class="final-note">
      <h2>七、总结</h2>
      <p>这个版本适合保留为“复现导向”的模板。它不从页面开始，而是从数据关系、模块边界和实现顺序入手，更适合展示项目的工程结构。读者看完后，可以知道应该先建哪些表、先写哪些接口、再接哪些页面。</p>
      <a href={projectUrl} target="_blank" rel="noreferrer">前往项目 ↗</a>
    </section>
  </main>
</BaseLayout>

<style>
  .blueprint-article { width: min(1180px, 92vw); margin: 0 auto; padding: 96px 0; }
  .back-link { display: inline-flex; margin-bottom: 24px; color: var(--ink-2); text-decoration: none; }
  .blueprint-hero { padding: clamp(34px,6vw,72px); border: 1px solid var(--line); border-radius: 34px; background: linear-gradient(135deg, rgba(86,199,169,.2), rgba(255,255,255,.045)); }
  .eyebrow { color: #69e6c2; letter-spacing: .22em; text-transform: uppercase; }
  .title-row { display: flex; gap: 18px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .title-row a, .final-note a { padding: 10px 14px; border: 1px solid var(--line); border-radius: 999px; background: rgba(255,255,255,.07); color: var(--ink); text-decoration: none; }
  h1 { max-width: 820px; margin: 12px 0 18px; color: var(--ink); font-size: clamp(38px,7vw,78px); line-height: 1.02; }
  h2, h3 { color: var(--ink); }
  p, li, span, footer { color: var(--ink-2); line-height: 1.9; }
  .map-section, .data-first, .tech-blueprint, .build-order, .code-board, .result-section, .final-note { margin-top: 24px; padding: 28px; border: 1px solid var(--line); border-radius: 26px; background: rgba(255,255,255,.045); }
  .module-map { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin-top: 18px; }
  .module-map div { padding: 16px; border: 1px solid var(--line); border-radius: 18px; background: rgba(86,199,169,.08); }
  .module-map b, .data-first strong, .layers span, .build-order strong { color: var(--ink); }
  .data-first > div, .layers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .data-first article, .layers div { padding: 18px; border: 1px solid var(--line); border-radius: 18px; background: rgba(255,255,255,.035); }
  .build-order li { margin: 9px 0; }
  .code-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .code-grid article { display: grid; gap: 12px; padding: 18px; border: 1px solid var(--line); border-radius: 22px; background: rgba(0,0,0,.12); }
  .code-grid header span { color: #69e6c2; font-size: 18px; }
  pre { margin: 0; overflow-x: auto; padding: 18px; border-radius: 16px; background: rgba(0,0,0,.38); color: #e9fff8; font-size: 13px; line-height: 1.7; }
  .result-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  figure { margin: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 20px; background: rgba(255,255,255,.035); }
  img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  figcaption { display: grid; gap: 5px; padding: 14px; }
  figcaption strong { color: var(--ink); }
  @media (max-width: 1000px) { .module-map { grid-template-columns: repeat(2, 1fr); } .code-grid { grid-template-columns: 1fr; } }
  @media (max-width: 720px) { .module-map, .data-first > div, .layers, .result-grid { grid-template-columns: 1fr; } }
</style>
