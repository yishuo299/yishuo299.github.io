---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { codeSections, projectUrl, screenshots, techStack } from "../../data/courseSelectionArticleData";

const journeys = [
  ["学生", "筛选课程、提交选课、查看课表，成绩发布后查询学习结果。"],
  ["教师", "查看授课课程，录入学生成绩，并提交给教务审核。"],
  ["教务", "维护课程资源、安排开课、控制选课开放、审核成绩。"],
  ["管理员", "维护用户、角色、权限，查询操作日志，保证系统可管理。"],
];
---

<BaseLayout sideBarActiveItemID="projects">
  <main class="story-article">
    <a class="back-link" href="/#projects">← 返回项目列表</a>

    <section class="story-hero">
      <div>
        <p class="eyebrow">Template 02 · 场景导览型</p>
        <div class="title-row">
          <h1>从一次选课开始，理解整套教务系统</h1>
          <a href={projectUrl} target="_blank" rel="noreferrer">前往项目 ↗</a>
        </div>
        <p>这篇文章用“用户如何使用系统”的方式介绍项目。读者先看到角色怎么进入系统，再看到选课、课表、成绩、权限和日志如何串起来，适合想快速理解项目使用流程的人。</p>
      </div>
      <img src={screenshots[0].src} alt="选课系统登录入口" />
    </section>

    <section class="journey">
      <h2>一、项目介绍：系统解决什么问题</h2>
      <p>在教务管理中，课程从开设到学生选择，再到成绩录入和发布，需要多个角色配合。如果只做课程列表，就无法体现系统完整性；如果只做后台管理，又缺少学生选课这个核心场景。因此本项目把“选课”作为主线，把教师、教务和管理员的功能放在主线周围，形成一套完整的课程管理系统。</p>
    </section>

    <section class="role-strip">
      {journeys.map(([role, desc]) => <article><span>{role}</span><p>{desc}</p></article>)}
    </section>

    <section class="journey">
      <h2>二、功能介绍：按一次完整使用流程展开</h2>
      <div class="steps">
        <div><b>Step 1</b><p>管理员创建用户和角色，配置学生、教师、教务管理员可以访问的菜单。</p></div>
        <div><b>Step 2</b><p>教务管理员维护课程基础信息，并为某个学期开设课程，设置教师、教室、时间和容量。</p></div>
        <div><b>Step 3</b><p>学生在选课页面筛选课程并提交选课，系统自动检查容量、重复选择和时间冲突。</p></div>
        <div><b>Step 4</b><p>选课完成后系统生成学生课表，教师后续录入成绩并提交审核。</p></div>
        <div><b>Step 5</b><p>教务审核成绩后发布，学生可以在成绩查询页面看到最终结果。</p></div>
      </div>
    </section>

    <section class="tech-story">
      <h2>三、技术栈介绍：页面和数据如何配合</h2>
      <div>{techStack.map(([name, desc]) => <p><strong>{name}</strong>{desc}</p>)}</div>
    </section>

    <section class="code-story">
      <h2>四、关键代码段：从用户操作到后端规则</h2>
      {codeSections.map((item, index) => (
        <article>
          <div class="number">{String(index + 1).padStart(2, "0")}</div>
          <div class="explain">
            <h3>{item.title}</h3>
            <p>{item.method}</p>
            <p>{item.purpose}</p>
          </div>
          <pre><code>{item.code}</code></pre>
        </article>
      ))}
    </section>

    <section class="result-wall">
      <h2>五、项目运行结果</h2>
      <p>运行项目后，用户可以从登录页进入系统。学生端能完成选课和课表查看，教师端能完成开课与成绩录入，管理员端能完成权限、用户和日志管理。下面的页面截图展示了系统中最核心的几个结果。</p>
      <div>{screenshots.map((shot) => <figure><img src={shot.src} alt={shot.title} loading="lazy" /><figcaption>{shot.title}</figcaption></figure>)}</div>
    </section>

    <section class="closing">
      <h2>六、总结</h2>
      <p>这个版本的讲解重点是“流程感”。读者不需要先理解所有数据库表，也能从一次选课过程看懂系统为什么需要登录鉴权、课程开设、选课校验、课表展示、成绩审核和操作日志。适合公开展示给想快速了解项目的人。</p>
      <a href={projectUrl} target="_blank" rel="noreferrer">前往项目 ↗</a>
    </section>
  </main>
</BaseLayout>

<style>
  .story-article { width: min(1180px, 92vw); margin: 0 auto; padding: 96px 0; }
  .back-link { display: inline-flex; margin-bottom: 24px; color: var(--ink-2); text-decoration: none; }
  .story-hero { display: grid; grid-template-columns: 1.05fr .95fr; gap: 26px; align-items: center; padding: clamp(28px,5vw,58px); border: 1px solid var(--line); border-radius: 34px; background: radial-gradient(circle at top left, rgba(138,180,255,.24), transparent 38%), rgba(255,255,255,.055); }
  .story-hero img { width: 100%; border-radius: 24px; box-shadow: 0 30px 80px rgba(0,0,0,.32); }
  .eyebrow { color: var(--accent); letter-spacing: .22em; text-transform: uppercase; }
  .title-row { display: grid; gap: 14px; }
  .title-row a, .closing a { width: fit-content; padding: 10px 14px; border: 1px solid var(--line); border-radius: 999px; background: rgba(255,255,255,.07); color: var(--ink); text-decoration: none; }
  h1 { margin: 12px 0 18px; color: var(--ink); font-size: clamp(36px,6vw,72px); line-height: 1.05; }
  h2, h3 { color: var(--ink); }
  p { color: var(--ink-2); line-height: 1.9; }
  .journey, .tech-story, .code-story, .result-wall, .closing { margin-top: 24px; padding: 28px; border: 1px solid var(--line); border-radius: 26px; background: rgba(255,255,255,.045); }
  .role-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 18px; }
  .role-strip article { padding: 18px; border: 1px solid var(--line); border-radius: 22px; background: rgba(138,180,255,.09); }
  .role-strip span { color: var(--accent); font-size: 20px; }
  .steps { display: grid; gap: 12px; }
  .steps div { padding: 16px; border-left: 3px solid var(--accent); background: rgba(255,255,255,.035); border-radius: 0 16px 16px 0; }
  .steps b, .tech-story strong { color: var(--ink); margin-right: 8px; }
  .tech-story div { columns: 2 320px; column-gap: 34px; }
  .code-story { display: grid; gap: 18px; }
  .code-story > h2 { margin-bottom: 0; }
  .code-story article { display: grid; grid-template-columns: 70px minmax(220px,.8fr) minmax(0,1.2fr); gap: 16px; padding: 18px; border: 1px solid var(--line); border-radius: 22px; background: rgba(0,0,0,.12); }
  .number { color: var(--accent); font-size: 30px; }
  pre { margin: 0; overflow-x: auto; padding: 18px; border-radius: 16px; background: rgba(0,0,0,.38); color: #eef5ff; font-size: 13px; line-height: 1.7; }
  .result-wall div { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  figure { margin: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 18px; background: rgba(255,255,255,.035); }
  figure img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  figcaption { padding: 12px; color: var(--ink); }
  @media (max-width: 920px) { .story-hero, .code-story article { grid-template-columns: 1fr; } .role-strip, .result-wall div { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .role-strip, .result-wall div { grid-template-columns: 1fr; } }
</style>
