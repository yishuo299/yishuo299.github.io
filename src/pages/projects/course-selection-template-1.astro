---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { codeSections, modules, projectUrl, screenshots, techStack } from "../../data/courseSelectionArticleData";
---

<BaseLayout sideBarActiveItemID="projects">
  <main class="formal-article">
    <a class="back-link" href="/#projects">← 返回项目列表</a>

    <section class="formal-hero">
      <p class="eyebrow">Template 01 · 项目说明文档型</p>
      <div class="title-row">
        <h1>选课与成绩管理系统</h1>
        <a href={projectUrl} target="_blank" rel="noreferrer">前往项目 ↗</a>
      </div>
      <p class="lead">这是一个基于 Spring Boot、Vue 3 和 MySQL 的前后端分离教务管理系统。项目围绕学校选课场景展开，完成了用户登录、角色权限、课程开设、学生选课、教师成绩录入、教务审核、管理员维护和操作日志追踪等功能。</p>
    </section>

    <section class="overview-grid">
      <article><span>项目定位</span><p>项目适合作为 Java Web 综合实践案例，重点展示从数据库设计、后端接口、业务规则到前端后台页面的完整开发过程。</p></article>
      <article><span>核心用户</span><p>系统面向学生、教师、教务管理员和系统管理员四类角色，不同角色进入系统后看到不同菜单和功能。</p></article>
      <article><span>业务闭环</span><p>课程先由教务开设，学生在开放时间内选课，教师录入成绩，教务审核发布，学生最终查询成绩。</p></article>
    </section>

    <section class="chapter">
      <h2>一、项目构成</h2>
      <p>系统可以分成前端、后端、数据库和文档四个部分。前端负责后台页面和交互，后端负责接口和业务规则，数据库保存核心业务数据，文档说明项目启动方式和功能结构。</p>
      <div class="module-table">{modules.map(([name, desc]) => <div><strong>{name}</strong><span>{desc}</span></div>)}</div>
    </section>

    <section class="chapter">
      <h2>二、功能介绍</h2>
      <div class="feature-grid">
        <article><h3>学生端</h3><p>学生登录后可以查看课程列表，按课程名称、教师、学期等条件筛选课程；提交选课后，系统会判断容量、重复选择和时间冲突；选课完成后可以查看个人课表，并在成绩发布后查询成绩。</p></article>
        <article><h3>教师端</h3><p>教师可以查看自己负责的课程，维护课程相关信息，录入学生成绩。成绩录入后可提交给教务审核，审核通过后才会发布给学生。</p></article>
        <article><h3>教务端</h3><p>教务管理员负责维护课程、学期、教室、教师安排、开课容量和成绩审核。这个角色连接课程资源和学生选课结果，是业务流转的核心。</p></article>
        <article><h3>管理员端</h3><p>系统管理员可以管理用户、角色、权限和操作日志，保证系统可以被维护、追踪和扩展。</p></article>
      </div>
    </section>

    <section class="chapter">
      <h2>三、使用技术栈</h2>
      <div class="tech-table">{techStack.map(([name, desc]) => <div><b>{name}</b><p>{desc}</p></div>)}</div>
    </section>

    <section class="chapter">
      <h2>四、关键代码段</h2>
      <p>下面列出项目中最关键的代码片段。每段代码都对应一个真实模块，读者可以根据这些片段理解项目的主要实现方式，再结合项目文件进行复现。</p>
      <div class="code-list">
        {codeSections.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p><strong>使用方法：</strong>{item.method}</p>
            <p><strong>项目作用：</strong>{item.purpose}</p>
            <pre><code>{item.code}</code></pre>
          </article>
        ))}
      </div>
    </section>

    <section class="chapter">
      <h2>五、项目运行结果</h2>
      <p>项目运行后可以看到完整的后台管理界面，包括登录页、教师开课、学生课表、学生成绩查询、管理员权限管理、操作日志查询和用户管理等页面。这些页面共同证明系统已经跑通了从登录到课程管理、选课、成绩发布和后台维护的主要流程。</p>
      <div class="screens">{screenshots.map((shot) => <figure><img src={shot.src} alt={shot.title} loading="lazy" /><figcaption><strong>{shot.title}</strong><span>{shot.desc}</span></figcaption></figure>)}</div>
    </section>

    <section class="final-card">
      <h2>六、总结</h2>
      <p>这套系统的重点不是单个页面，而是完整业务链路。读者看完后，可以明确知道项目由哪些模块组成、每个角色完成什么操作、后端如何保证数据正确、前端如何与接口配合。如果要复现，建议先完成登录和学生选课主流程，再逐步扩展成绩审核、权限管理和日志模块。</p>
      <a href={projectUrl} target="_blank" rel="noreferrer">前往项目 ↗</a>
    </section>
  </main>
</BaseLayout>

<style>
  .formal-article { position: relative; z-index: 3; width: min(1120px, 92vw); margin: 0 auto; padding: 96px 0; }
  .back-link { display: inline-flex; margin-bottom: 24px; color: var(--ink-2); text-decoration: none; }
  .formal-hero, .overview-grid article, .chapter, .final-card { border: 1px solid var(--article-line); background: var(--article-surface); box-shadow: var(--article-shadow); backdrop-filter: blur(18px) saturate(1.1); }
  .formal-hero { padding: clamp(34px, 6vw, 68px); border-radius: 30px; }
  .eyebrow { color: var(--accent); letter-spacing: .22em; text-transform: uppercase; }
  .title-row { display: flex; gap: 18px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .title-row a, .final-card a { padding: 10px 14px; border: 1px solid var(--article-line); border-radius: 999px; background: var(--article-card); color: var(--ink); text-decoration: none; }
  h1 { max-width: 760px; margin: 10px 0 18px; color: var(--ink); font-size: clamp(42px, 8vw, 86px); line-height: .98; text-shadow: 0 2px 18px color-mix(in srgb, var(--bg) 35%, transparent); }
  h2, h3 { color: var(--ink); }
  p, span { color: var(--ink-2); line-height: 1.9; }
  .lead { max-width: 860px; font-size: 19px; }
  .overview-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 22px; }
  .overview-grid article, .chapter, .final-card { padding: 28px; border-radius: 24px; }
  .overview-grid span { color: var(--accent); letter-spacing: .12em; }
  .chapter, .final-card { margin-top: 22px; }
  .module-table, .tech-table, .feature-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .module-table div, .tech-table div, .feature-grid article { padding: 18px; border: 1px solid var(--article-line); border-radius: 18px; background: var(--article-card); }
  .module-table strong, .tech-table b, .code-list strong { color: var(--ink); }
  .code-list { display: grid; gap: 18px; }
  .code-list article { padding: 20px; border: 1px solid var(--article-line); border-radius: 20px; background: var(--article-surface-soft); }
  pre { overflow-x: auto; padding: 18px; border-radius: 16px; background: var(--article-code); color: #eef5ff; font-size: 13px; line-height: 1.7; }
  .screens { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  figure { margin: 0; overflow: hidden; border: 1px solid var(--article-line); border-radius: 20px; background: var(--article-card); }
  img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; }
  figcaption { display: grid; gap: 5px; padding: 14px; }
  figcaption strong { color: var(--ink); }
  @media (max-width: 820px) { .overview-grid, .module-table, .tech-table, .feature-grid, .screens { grid-template-columns: 1fr; } }
</style>
