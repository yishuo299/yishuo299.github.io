---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="能力与服务" sideBarActiveItemID="services">
  <div>
    <div class="text-3xl w-full font-bold mb-5">能力与服务</div>
  </div>

  <HorizontalCard
    title="前端开发"
    img="/post_img.webp"
    desc="构建清晰、快速、易维护的 Web 界面。"
    badge="擅长"
    url="#"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="自动化与效率工具"
    img="/post_img.webp"
    desc="让重复流程自动运行，把时间留给更重要的事。"
    url="#"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="数据可视化"
    img="/post_img.webp"
    desc="将复杂数据转化为直观、可行动的信息。"
    url="#"
    badge="实践中"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="技术记录与分享"
    img="/post_img.webp"
    desc="记录项目经验，也记录每一次复盘与成长。"
    url="#"
  />
</BaseLayout>
